[
  {
    "id": "hero",
    "nome": "Hero",
    "enabled": true,
    "html": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link href=\"https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n#main-content{--ink:#15191d;--line:#eadfd2;--warm:#fbf3ea;--muted:#54483c;--y:#ff8a1f;--gd:#d9480f;--deep:#7c2d0a;--d:'Archivo Narrow','Arial Narrow',sans-serif;--ease:cubic-bezier(.16,1,.3,1)}\n#main-content ::selection{background:#ff8a1f;color:#15191d}\n.ex-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:.8rem 1.6rem;font-family:var(--d);font-weight:700;font-size:1.05rem;border-radius:2px;text-decoration:none;border:1px solid transparent;transition:background-color .2s var(--ease),border-color .2s var(--ease)}\n.ex-btn:focus-visible{outline:3px solid var(--ink);outline-offset:3px}.ex-end .ex-btn:focus-visible{outline-color:var(--y)}\n.ex-btn-y{background:var(--y);color:var(--ink)}.ex-btn-y:hover{background:#ffb347}\n.ex-btn-o{border-color:#8b9580;color:var(--ink)}.ex-btn-o:hover{border-color:var(--ink)}\n.ex-btn-k{background:var(--ink);color:#fff}.ex-btn-k:hover{background:#2a323a}\n.ex-band .ex-btn:focus-visible{outline-color:var(--ink)}\n.ex-hero{background:#eef3e4;color:var(--ink);box-sizing:border-box;display:flex;align-items:center;min-height:calc(100vh - 80px);min-height:calc(100svh - 80px);padding:clamp(1.5rem,4vh,4rem) 1.5rem}\n.ex-hero-in{width:100%;max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1.2fr 1fr;gap:clamp(2rem,5vw,4.5rem);align-items:start}\n.ex-hero h1{font-family:var(--d);font-weight:700;font-size:clamp(2.5rem,5.4vw,4.4rem);line-height:1;letter-spacing:-.01em;color:var(--ink);margin:0 0 1.5rem;max-width:12ch;text-wrap:balance}\n.ex-hero p{font-size:1.1rem;line-height:1.6;color:#3d444a;max-width:46ch;margin:0 0 2rem}\n.ex-actions{display:flex;gap:1rem;flex-wrap:wrap}\n.ex-fig{margin:0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.8fr);gap:1.5rem;align-items:stretch}\n.ex-fig svg{width:100%;height:auto;max-height:min(520px,calc(100svh - 11rem));display:block}\n.ex-stats{display:flex;flex-direction:column;justify-content:space-between;padding:0 0 1.5rem;margin:0;list-style:none}\n.ex-stats li{border-top:1px solid #b9c4a6;padding-top:.75rem;margin:0}\n.ex-num{display:block;font-family:var(--d);font-weight:700;font-size:clamp(2rem,3.4vw,2.8rem);line-height:1;color:var(--gd);font-variant-numeric:tabular-nums}\n.ex-lab{display:block;font-size:.92rem;line-height:1.4;color:#54483c;margin-top:.35rem}\n.ex-rope,.ex-rope2{stroke-dasharray:1;animation:ex-draw 1.8s var(--ease) both}\n.ex-man{animation:ex-drop 1.8s var(--ease) both}.ex-sway{transform-origin:0 -60px;animation:ex-sway 4.2s ease-in-out 1.8s infinite alternate}.ex-legs{transform-origin:0 2px;animation:ex-push 2.6s ease-in-out 1.8s infinite alternate}\n@keyframes ex-draw{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}\n@keyframes ex-drop{from{transform:translateY(-222px)}}@keyframes ex-sway{from{transform:rotate(-1.4deg)}to{transform:rotate(1.4deg)}}@keyframes ex-push{from{transform:rotate(0)}to{transform:rotate(-4deg)}}\n@media (prefers-reduced-motion:reduce){.ex-rope,.ex-rope2,.ex-man,.ex-sway,.ex-legs{animation:none}}\n.ex-sec{padding:clamp(3.5rem,8vw,6.5rem) 1.5rem;background:#fff}\n.ex-sec-warm{background:var(--warm)}\n.ex-wrap{max-width:1180px;margin:0 auto}\n.ex-h2{font-family:var(--d);font-weight:700;font-size:clamp(2rem,3.4vw,3rem);line-height:1.08;color:var(--ink);margin:0;text-wrap:balance}\n.ex-2col{display:grid;grid-template-columns:1fr 1.3fr;gap:clamp(2rem,5vw,4.5rem);align-items:start}\n.ex-lead{font-size:1.1rem;line-height:1.65;color:var(--muted);max-width:38ch;margin:1.25rem 0 0}\n.ex-pts{list-style:none;margin:0;padding:0}\n.ex-pts li{padding:1.25rem 0;border-top:1px solid #d6d3c9;margin:0}.ex-pts li:last-child{border-bottom:1px solid #d6d3c9}\n.ex-pts b{display:block;font-family:var(--d);font-size:1.35rem;line-height:1.2;color:var(--ink);margin-bottom:.3rem}\n.ex-pts span{font-size:1rem;line-height:1.6;color:var(--muted)}\n.ex-grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:2.5rem;margin-top:3rem}\n.ex-grid3>div{border-top:2px solid var(--ink);padding-top:1rem}\n.ex-grid3 h3{font-family:var(--d);font-size:1.35rem;font-weight:700;color:var(--ink);margin:0 0 .4rem;line-height:1.2}\n.ex-grid3 p{margin:0;font-size:1rem;line-height:1.6;color:var(--muted)}\n.ex-svc-head{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;flex-wrap:wrap;padding-bottom:1.75rem;border-bottom:2px solid var(--ink)}\n.ex-svc-head p{margin:0;color:var(--muted);max-width:34ch;font-size:1.02rem;line-height:1.5}\n.ex-svcs{display:grid;grid-template-columns:repeat(2,1fr);column-gap:3rem}\n.ex-svc{display:grid;grid-template-columns:1fr auto;gap:.25rem 1rem;align-items:center;padding:1.3rem .25rem;border-bottom:1px solid var(--line);text-decoration:none;color:inherit;transition:background-color .2s var(--ease),padding .2s var(--ease)}\n.ex-svc:hover{background:var(--warm);padding-left:.9rem}\n.ex-svc:focus-visible{outline:3px solid var(--ink);outline-offset:-3px}\n.ex-svc-t{font-family:var(--d);font-weight:700;font-size:1.25rem;line-height:1.2;color:var(--ink)}\n.ex-svc-d{grid-column:1;font-size:.95rem;line-height:1.5;color:var(--muted)}\n.ex-svc svg{grid-column:2;grid-row:1/span 2;width:20px;height:20px;stroke:var(--ink);fill:none;stroke-width:2;transition:transform .2s var(--ease)}\n.ex-svc:hover svg{transform:translateX(4px)}\n.ex-band{background:var(--y);padding:clamp(3rem,6vw,4.5rem) 1.5rem}\n.ex-end{background:var(--deep);padding:clamp(3rem,6vw,4.5rem) 1.5rem}\n.ex-band-in{max-width:1180px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;gap:2rem;flex-wrap:wrap}\n.ex-band p{margin:.6rem 0 0;color:#2c3136;font-size:1.1rem;line-height:1.5}\n.ex-end .ex-h2{color:#fff}.ex-end p{margin:.6rem 0 0;color:#d7e2c6;font-size:1.1rem;line-height:1.5}\n@media (max-width:820px){.ex-hero-in,.ex-2col{grid-template-columns:1fr}.ex-fig{max-width:440px}.ex-grid3{grid-template-columns:1fr 1fr}.ex-svcs{grid-template-columns:1fr}}\n@media (max-width:560px){.ex-grid3{grid-template-columns:1fr}.ex-sec,.ex-hero,.ex-band,.ex-end{padding-left:1.25rem;padding-right:1.25rem}}\n</style>\n<header class=\"ex-hero\" aria-label=\"Hero\"><div class=\"ex-hero-in\"><div><h1>Il tuo server, pronto in pochi minuti.</h1><p>Server di gioco, VPS e hosting a prezzi di mercato, con un pannello web per gestire tutto da solo. Partiamo da un primo nodo e ne aggiungiamo altri man mano che le richieste crescono: pre-ordina ora, nessun pagamento anticipato.</p><div class=\"ex-actions\"><a class=\"ex-btn ex-btn-y\" href=\"__BASEURL__/negozio/\">Pre-ordina un piano</a><a class=\"ex-btn ex-btn-o\" href=\"#servizi\">Guarda i piani</a></div></div><figure class=\"ex-fig\" style=\"grid-template-columns:1fr\"><ul class=\"ex-stats\"><li><span class=\"ex-num\">da 4,99 €</span><span class=\"ex-lab\">al mese, server Minecraft 2 GB</span></li><li><span class=\"ex-num\">da 7,99 €</span><span class=\"ex-lab\">al mese, VPS Linux con accesso root</span></li><li><span class=\"ex-num\">da 6,99 €</span><span class=\"ex-lab\">al mese, WordPress gestito</span></li></ul></figure></div></header>"
  },
  {
    "id": "whatis",
    "nome": "Perché partire dai server di gioco",
    "enabled": true,
    "html": "<section class=\"ex-sec\" id=\"whatis\" aria-labelledby=\"whatis-title\"><div class=\"ex-wrap ex-2col\"><div><h2 class=\"ex-h2\" id=\"whatis-title\">Perché partire dai server di gioco</h2><p class=\"ex-lead\">È un mercato con domanda continua e molti operatori. Lo attacchiamo con un primo nodo, prezzi in linea con il mercato e un pannello semplice.</p></div><ol class=\"ex-pts\"><li><b>Un nodo, tanti server</b><span>un solo server fisico ospita molti server di gioco, ognuno isolato dagli altri.</span></li><li><b>Si cresce a gradini</b><span>quando un nodo si riempie ne aggiungiamo un altro: i costi seguono le richieste.</span></li><li><b>Più giochi, stessa base</b><span>Minecraft, Palworld, Rust, ARK, FiveM e altri sullo stesso pannello.</span></li><li><b>Dal gioco al resto</b><span>stessa infrastruttura per VPS, WordPress gestito e app open source.</span></li></ol></div></section>"
  },
  {
    "id": "stack",
    "nome": "Sei motivi per sceglierci",
    "enabled": true,
    "html": "<section class=\"ex-sec ex-sec-warm\" id=\"stack\" aria-labelledby=\"stack-title\"><div class=\"ex-wrap\"><h2 class=\"ex-h2\" id=\"stack-title\">Sei motivi per sceglierci</h2><div class=\"ex-grid3\"><div><h3>Prezzi chiari</h3><p>Canone mensile, senza vincolo di durata.</p></div><div><h3>Pannello web</h3><p>Avvia, ferma, installa mod e fai backup senza SSH.</p></div><div><h3>Server isolati</h3><p>Ogni server gira separato dagli altri sullo stesso nodo.</p></div><div><h3>Nessun pagamento ora</h3><p>Pre-ordini il piano e ti scriviamo quando è pronto.</p></div><div><h3>Supporto in italiano</h3><p>Scrivici dalla pagina Contatti, rispondiamo in italiano.</p></div><div><h3>Cresciamo con te</h3><p>Se serve più potenza passi a un piano più grande.</p></div></div></div></section>"
  },
  {
    "id": "features",
    "nome": "Servizi",
    "enabled": true,
    "html": "<section class=\"ex-sec\" id=\"servizi\" aria-labelledby=\"features-title\"><div class=\"ex-wrap\"><div class=\"ex-svc-head\"><h2 class=\"ex-h2\" id=\"features-title\">Servizi</h2><p>Un solo metodo: accesso su corda, nessun ponteggio.</p></div><div class=\"ex-svcs\"><a class=\"ex-svc\" href=\"/servizi/impermeabilizzazione-su-fune/\"><span class=\"ex-svc-t\">Impermeabilizzazione su fune</span><span class=\"ex-svc-d\">Terrazzi, tetti e lastre protetti dall'acqua e dagli agenti atmosferici.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/riparazione-e-pulizia-grondaie/\"><span class=\"ex-svc-t\">Riparazione e pulizia grondaie</span><span class=\"ex-svc-d\">Pulizia di grondaie e pluviali, con riparazione o sostituzione dei tratti danneggiati.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/montaggio-isolanti/\"><span class=\"ex-svc-t\">Montaggio isolanti</span><span class=\"ex-svc-d\">Isolamento termico eseguito in quota senza ponteggi.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/pulizia-manutenzione-e-installazione-canne-fumarie/\"><span class=\"ex-svc-t\">Canne fumarie</span><span class=\"ex-svc-d\">Pulizia, manutenzione e installazione anche in copertura.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/installazione-e-manutenzione-dissuasori-per-piccioni/\"><span class=\"ex-svc-t\">Dissuasori per piccioni</span><span class=\"ex-svc-d\">Installazione e manutenzione di sistemi anti-volatili.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/montaggio-sistemi-di-sicurezza-su-fune/\"><span class=\"ex-svc-t\">Sistemi di sicurezza su fune</span><span class=\"ex-svc-d\">Installazione di linee vita e ancoraggi per lavorare in sicurezza in copertura.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/rimozione-materiale-pericolante/\"><span class=\"ex-svc-t\">Messa in sicurezza</span><span class=\"ex-svc-d\">Rimozione urgente di materiale pericolante su fune.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/potatura-alberi/\"><span class=\"ex-svc-t\">Potatura alberi</span><span class=\"ex-svc-d\">Interventi su piante alte e difficili da raggiungere.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/pulizia-componenti-su-fune/\"><span class=\"ex-svc-t\">Pulizia componenti su fune</span><span class=\"ex-svc-d\">Pulizia mirata di elementi in quota su ogni edificio.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/pulizia-pannelli-fotovoltaici/\"><span class=\"ex-svc-t\">Pulizia pannelli fotovoltaici</span><span class=\"ex-svc-d\">Manutenzione per mantenere alta l'efficienza dell'impianto.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/pulizia-vetri/\"><span class=\"ex-svc-t\">Pulizia vetri in altezza</span><span class=\"ex-svc-d\">Vetrate di condomini, uffici e palazzi in quota, senza piattaforma aerea.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/ristrutturazioni-balconi-e-facciate/\"><span class=\"ex-svc-t\">Ristrutturazioni balconi e facciate</span><span class=\"ex-svc-d\">Ristrutturazione e ripristino estetico e strutturale.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a></div></div></section>"
  },
  {
    "id": "pricing",
    "nome": "Pre-ordine",
    "enabled": true,
    "html": "<section class=\"ex-band\" id=\"pricing\" aria-labelledby=\"pricing-title\"><div class=\"ex-band-in\"><div><h2 class=\"ex-h2\" id=\"pricing-title\">Pre-ordina il tuo server</h2><p>Nessun pagamento ora: ti scriviamo appena il server è pronto.</p></div><a class=\"ex-btn ex-btn-k\" href=\"__BASEURL__/negozio/\">Vai ai piani</a></div></section>"
  },
  {
    "id": "cta",
    "nome": "CTA finale",
    "enabled": false,
    "html": "<section class=\"ex-end\" aria-labelledby=\"cta-title\"><div class=\"ex-band-in\"><div><h2 class=\"ex-h2\" id=\"cta-title\">Non trovi il gioco che cerchi?</h2><p>Scrivici: i giochi più richiesti li attiviamo per primi.</p></div><a class=\"ex-btn ex-btn-y\" href=\"__BASEURL__/contatti/\">Contattaci</a></div></section>"
  }
]
